# Môi trường ứng dụng: "development" (hoặc "dev") | "production" (hoặc "prod")
# - "development": Kết nối tới Backend API tại NEXT_PUBLIC_API_URL (http://localhost:3001/api/v1)
# - "production": Tự động dùng dữ liệu Mock local đầy đủ (cho trường hợp Backend chưa live trên server)
NEXT_PUBLIC_APP_ENV=development

# Backend API URL (Sử dụng khi NEXT_PUBLIC_APP_ENV=development)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Tùy chọn ép buộc dùng Mock data ở bất kỳ môi trường nào (true / false)
NEXT_PUBLIC_USE_MOCK_DATA=false
