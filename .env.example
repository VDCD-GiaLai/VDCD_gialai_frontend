# Môi trường ứng dụng: "development" (Dev mode) | "production" (Prod mode)
# - "development": Chế độ DEV - Dùng 100% Mock data local độc lập (Không cần bật Backend API)
# - "production": Chế độ PROD - Kết nối trực tiếp Backend API tại NEXT_PUBLIC_API_URL
NEXT_PUBLIC_APP_ENV=development

# Backend API URL (Sử dụng khi NEXT_PUBLIC_APP_ENV=production)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Tùy chọn ép buộc dùng Mock data ở bất kỳ môi trường nào (true / false)
NEXT_PUBLIC_USE_MOCK_DATA=false
