# Backend API URL (Default: http://localhost:3001/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Toggle Mock Data vs Live Backend API
# Set "true" to use 100% local mock data (when Backend is NOT live or for Netlify/Vercel previews)
# Set "false" to use live NestJS Backend API
NEXT_PUBLIC_USE_MOCK_DATA=false
